{
  "name": "@haroon0x/dsh-message-edit",
  "version": "1.2.0",
  "description": "Edit a sent user message in DeepSeek Harness: send the corrected text in the same chat or fork a branch, optionally rewinding the files that turn changed.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "haroon0x",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "message-edit",
    "session-fork",
    "agent",
    "llm"
  ],
  "homepage": "https://github.com/haroon0x/dsh-message-edit#readme",
  "bugs": {
    "url": "https://github.com/haroon0x/dsh-message-edit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haroon0x/dsh-message-edit.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
